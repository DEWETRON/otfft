+    complex_t* FFT::workFor(complex_vector x) const noexcept
+    {
+        const std::uintptr_t page = 4096;
+        const std::uintptr_t want = (reinterpret_cast<std::uintptr_t>(x) + static_cast<std::uintptr_t>(workOffsetBytes())) & (page - 1);
+        const std::uintptr_t have = reinterpret_cast<std::uintptr_t>(y) & (page - 1);
+        const std::uintptr_t shift = ((want - have) & (page - 1)) & ~static_cast<std::uintptr_t>(31);
+        return reinterpret_cast<complex_t*>(reinterpret_cast<char*>(y) + shift);
+    }
